# --- CẤU HÌNH NHÀ CUNG CẤP AI ---
# Chọn nhà cung cấp: 'gemini', 'openai', hoặc 'mock' (chạy thử nghiệm không cần key)
AI_PROVIDER=gemini

# Google Gemini API Key (Đăng ký miễn phí tại https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (Tuỳ chọn nếu dùng AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- CẤU HÌNH HỆ THỐNG & MẠNG ---
HOST=0.0.0.0
PORT=8000
DEBUG=False
SECRET_KEY=change_this_secret_key_in_production_32chars

# --- BẢO MẬT & RATE LIMIT ---
MAX_MESSAGES_PER_MINUTE=20
MAX_INPUT_LENGTH=1500

# --- TELEGRAM BOT (Tuỳ chọn) ---
# Nếu muốn chạy bot Telegram song song, điền Token từ @BotFather
TELEGRAM_BOT_TOKEN=
